@@ -27,6 +27,22 @@ public static partial class KoreaderHelper
     [GeneratedRegex(@"^#_doc_fragment_?(\d+)")]
     private static partial Regex DocFragmentHashRegex();
 
+    /// <summary>
+    /// Matches the id("some-id") / id('some-id') selector the web reader saves as BookScrollId, id captured in Group 1
+    /// </summary>
+    [GeneratedRegex(@"^id\((?:""|')?([^""')]+)(?:""|')?\)", RegexOptions.IgnoreCase)]
+    private static partial Regex IdSelectorRegex();
+
+    /// <summary>
+    /// Extracts the element id from an id("...") xpath selector, or null if the xpath is not one.
+    /// </summary>
+    public static string? GetElementIdFromXPath(string? xpath)
+    {
+        if (string.IsNullOrWhiteSpace(xpath)) return null;
+        var match = IdSelectorRegex().Match(xpath.Trim());
+        return match.Success ? match.Groups[1].Value : null;
+    }
+
