diff --git a/Kavita.Services/BookService.cs b/Kavita.Services/BookService.cs
index b8c76ed..75fdf83 100644
--- a/Kavita.Services/BookService.cs
+++ b/Kavita.Services/BookService.cs
@@ -1950,6 +1950,54 @@ public partial class BookService(
         }
     }
 
+    /// <summary>
+    /// The web reader stores its scroll position as id("...") whenever the element has an id. KOReader only
+    /// understands structural xpaths, so this resolves the id against the raw xhtml and builds a body-relative
+    /// path in the same style KOReader itself emits: an index is only added when the element has siblings
+    /// of the same name.
+    /// </summary>
+    public async Task<string?> GetXPathForElementId(string bookFilePath, int page, string elementId, CancellationToken ct = default)
+    {
+        if (string.IsNullOrEmpty(elementId)) return null;
+
+        try
+        {
+            using var book = await EpubReader.OpenBookAsync(bookFilePath, LenientBookReaderOptions);
+            var bookPages = await book.GetReadingOrderAsync();
+            if (page < 0 || page >= bookPages.Count) return null;
+
+            var content = await bookPages[page].ReadContentAsync();
+            var doc = new HtmlDocument { OptionFixNestedTags = true };
+            doc.LoadHtml(content);
+
+            var node = doc.GetElementbyId(elementId);
+            if (node == null) return null;
+
+            var parts = new List<string>();
+            for (var current = node; current != null && current.NodeType == HtmlNodeType.Element; current = current.ParentNode)
+            {
+                if (current.Name.Equals("body", StringComparison.OrdinalIgnoreCase))
+                {
+                    parts.Reverse();
+                    return "//body/" + string.Join('/', parts);
+                }
+
+                var sameName = current.ParentNode?.ChildNodes
+                    .Where(n => n.NodeType == HtmlNodeType.Element && n.Name.Equals(current.Name, StringComparison.OrdinalIgnoreCase))
+                    .ToList() ?? [current];
+                var index = sameName.IndexOf(current) + 1;
+                parts.Add(sameName.Count > 1 ? $"{current.Name.ToLowerInvariant()}[{index}]" : current.Name.ToLowerInvariant());
+            }
+
+            return null;
+        }
+        catch (Exception ex)
+        {
+            logger.LogWarning(ex, "Could not resolve element id {ElementId} on page {Page} of {FilePath}", elementId, page, bookFilePath);
+            return null;
+        }
+    }
+
